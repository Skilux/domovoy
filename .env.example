# DOMOVOY local secrets: template.
# Copy to ~/.config/domovoy/.env (outside the repo) and fill in. The skill scripts, the
# Actor's local runs and the build agents all read that one file. Never commit real values.
# Comments stay on their own lines: some readers don't strip inline comments.

# --- Actor: fee extraction (Vladimir) ---
# Featherless API key (featherless.ai, account API keys page)
FEATHERLESS_API_KEY=
# OpenAI key, used only when Featherless fails or times out
OPENAI_API_KEY=

# --- Notion shortlist (Vladimir) ---
# Internal integration "DOMOVOY" token, from Notion's integration settings
NOTION_TOKEN=
# ID of the parent page "DOMOVOY" the integration is connected to.
# notion.py setup creates the DOMOVOY shortlist database under it; the resulting
# data source ID goes into config.json, not here.
NOTION_PARENT_PAGE_ID=

# --- Apify (Vladimir) ---
# Used by search.py to start Actor runs through the API (console.apify.com > Settings > API & Integrations).
# The CLI uses `apify login` instead.
APIFY_TOKEN=

# --- Katastr check (Vladimir, stretch, #57) ---
# API KN (free REST, api-kn.cuzk.gov.cz): API key sent in the request header
CUZK_API_KN_KEY=
# WSDP (paid SOAP): customer account username and password
WSDP_USERNAME=
WSDP_PASSWORD=
# test (fictional data, free) or prod (billed per output)
WSDP_ENV=test
# Guard: max billed WSDP outputs per day
WSDP_MAX_BILLED_PER_DAY=10
# Folder with old LV XML files. Outside the repo; never copy them into a worktree
KATASTR_LV_DIR=~/.config/domovoy/lv
# --- Phone page (Danila) ---
# Deployed Vercel URL of the phone page
PHONE_URL=
# Shared secret for /api/call and /api/result
DOMOVOY_SECRET=
# Pairs one browser with the phone page: open PHONE_URL/?k=<this value> once on the demo laptop
DOMOVOY_RECEIVER_KEY=

# --- Phone server only ---
# These live in Vercel env vars. Uncomment only for local `vercel dev`.
# ELEVENLABS_API_KEY=
# ELEVENLABS_AGENT_ID=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Later (P1 / phase 2) ---
# PostHog (Danila), see posthog/README.md. Project token is public by design; used to send events
# POSTHOG_PROJECT_TOKEN=
# POSTHOG_INGEST_HOST=https://eu.i.posthog.com
# App host and project id, used to query events
# POSTHOG_APP_HOST=https://eu.posthog.com
# POSTHOG_PROJECT_ID=348322
# Personal API key, private: reads events. Laptop only, never Vercel or the Actor
# POSTHOG_PERSONAL_API_KEY=
