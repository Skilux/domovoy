{
  "title": "DOMOVOY shortlist contract",
  "description": "Notion database for the DOMOVOY shortlist, one page per flat. Source: docs/prd/actor.md (Notion property table) and docs/plan.md (Status values). Read by scripts/notion.py setup and by the Actor's NotionSink, which keeps a copy in apify/domovoy/schemas/ (drift test). owner names who writes a property after the page exists. actor_writes 'create' means the Actor writes it only when it creates the page. options: empty means any value (Notion adds new options). format is the Notion number format. Money is integer CZK.",
  "database_title": "DOMOVOY shortlist",
  "notion_api_version": "2026-03-11",
  "upsert_key": "Property ID",
  "call_context_values": {
    "lease_type": {"Lease": "najem", "Sublet": "podnajem", "Unknown": null}
  },
  "properties": {
    "Name": {"type": "title", "owner": "actor"},
    "Property ID": {"type": "rich_text", "owner": "actor"},
    "Status": {"type": "select", "owner": "actor", "actor_writes": "create", "options": ["Shortlisted", "Not interested", "Interested", "Calling", "Viewing booked", "Not booked"]},
    "Reason": {"type": "rich_text", "owner": "vladimir"},
    "Notes": {"type": "rich_text", "owner": "vladimir"},
    "Viewing date": {"type": "date", "owner": "claude"},
    "Profiles": {"type": "multi_select", "owner": "actor", "options": []},
    "Match": {"type": "select", "owner": "actor", "options": ["Strong", "Needs info"]},
    "Disposition": {"type": "select", "owner": "actor", "options": []},
    "Citypart": {"type": "select", "owner": "actor", "options": []},
    "Area m²": {"type": "number", "owner": "actor", "format": "number"},
    "Floor": {"type": "number", "owner": "actor", "format": "number"},
    "Metro m": {"type": "number", "owner": "actor", "format": "number"},
    "Elevator": {"type": "select", "owner": "actor", "options": ["Yes", "Partly", "No", "Unknown"]},
    "Furnished": {"type": "select", "owner": "actor", "options": ["Yes", "Partly", "No", "Unknown"]},
    "Address": {"type": "rich_text", "owner": "actor"},
    "Rent": {"type": "number", "owner": "actor", "format": "koruna"},
    "Services": {"type": "number", "owner": "actor", "format": "koruna"},
    "Energy": {"type": "number", "owner": "actor", "format": "koruna"},
    "Total monthly": {"type": "number", "owner": "actor", "format": "koruna"},
    "Kauce": {"type": "number", "owner": "actor", "format": "koruna"},
    "Commission": {"type": "number", "owner": "actor", "format": "koruna"},
    "Upfront": {"type": "number", "owner": "actor", "format": "koruna"},
    "Missing furniture cost": {"type": "number", "owner": "actor", "format": "koruna"},
    "Estimated": {"type": "multi_select", "owner": "actor", "options": []},
    "Lease type": {"type": "select", "owner": "actor", "options": ["Lease", "Sublet", "Unknown"]},
    "Move-in date": {"type": "date", "owner": "actor"},
    "Unknowns": {"type": "rich_text", "owner": "actor"},
    "Risk flags": {"type": "multi_select", "owner": "actor", "options": []},
    "Sources": {"type": "multi_select", "owner": "actor", "options": ["Sreality", "Bezrealitky", "iDNES"]},
    "URL": {"type": "url", "owner": "actor"},
    "Collected at": {"type": "date", "owner": "actor"},
    "First seen": {"type": "date", "owner": "actor"},
    "Last seen": {"type": "date", "owner": "actor"},
    "Agency": {"type": "rich_text", "owner": "actor"},
    "Contact": {"type": "rich_text", "owner": "actor"},
    "Email": {"type": "email", "owner": "actor"},
    "Phone": {"type": "phone_number", "owner": "actor"},
    "Owner listing": {"type": "checkbox", "owner": "actor"}
  }
}
