{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "call_context",
  "description": "Claude -> phone server -> ElevenLabs dynamic variables. Source: docs/plan.md, Contracts. Money is integer CZK. Times are ISO 8601 with offset. null means unknown, never zero. Extra fields are passed through.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "property_id", "notion_page_id", "address", "url", "collected_at",
    "rent", "total_monthly", "upfront", "kauce", "commission",
    "move_in_date", "lease_type", "missing_furniture_cost", "unknowns",
    "user_name", "budget_cap", "available_windows", "realtor_name"
  ],
  "properties": {
    "property_id": {"type": "string", "minLength": 1},
    "notion_page_id": {"type": "string", "minLength": 1},
    "address": {"type": "string"},
    "url": {"type": "string"},
    "collected_at": {"type": "string"},
    "rent": {"type": ["integer", "null"]},
    "total_monthly": {"type": ["integer", "null"]},
    "upfront": {"type": ["integer", "null"]},
    "kauce": {"type": ["integer", "null"]},
    "commission": {"type": ["integer", "null"]},
    "move_in_date": {"type": ["string", "null"]},
    "lease_type": {"enum": ["najem", "podnajem", null]},
    "missing_furniture_cost": {"type": ["integer", "null"]},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "user_name": {"type": "string", "minLength": 1},
    "budget_cap": {"type": "integer"},
    "available_windows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["start", "end"],
        "properties": {
          "start": {"type": "string"},
          "end": {"type": "string"}
        }
      }
    },
    "realtor_name": {"type": "string", "minLength": 1}
  }
}
