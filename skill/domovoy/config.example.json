{
  "repo_path": "~/domovoy",
  "backend": {
    "module": "scripts/notion.py"
  },
  "statuses": {
    "interested": "Interested",
    "calling": "Calling",
    "booked": "Viewing booked",
    "not_booked": "Not booked"
  },
  "phone": {
    "url": "",
    "secret": "",
    "env_file": "~/.config/domovoy/.env",
    "url_env": "PHONE_URL",
